msgstr[0] "%(n)s versión detectada"
msgstr[1] "%(n)s versiones detectadas"

msgid "%(n)s day"
msgid_plural "%(n)s days"
msgstr[0] "%(n)s día"
msgstr[1] "%(n)s días"

