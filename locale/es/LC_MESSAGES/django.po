msgid "Keep <code>https://mehdirahbe.github.io</code> in the allowed origins of the Tesla dashboard."
msgstr "Mantén <code>https://mehdirahbe.github.io</code> en los orígenes permitidos del panel de Tesla."

msgid "Verify the published key, register the EU region, then resync vehicles."
msgstr "Verifica la clave publicada, registra la región EU y resincroniza los vehículos."

msgid "Generate EC key"
msgstr "Generar clave EC"

msgid "Verify key"
msgstr "Verificar clave"

msgid "Register · EU"
msgstr "Registrar · EU"

msgid "Public URL"
msgstr "URL pública"

msgid "Local file"
msgstr "Archivo local"

msgid "Show public key"
msgstr "Mostrar clave pública"

msgid "Tesla account authorization"
msgstr "Autorización de la cuenta Tesla"

msgid "Tesla will ask you to confirm access. MaTesla never receives your password."
msgstr "Tesla te pedirá confirmar el acceso. MaTesla nunca recibe tu contraseña."

msgid "Redirect URI"
msgstr "URI de redirección"

msgid "Sign in with Tesla"
msgstr "Iniciar sesión con Tesla"

msgid "Save the Client ID and secret in step 1 first."
msgstr "Guarda primero el Client ID y el secret en el paso 1."

msgid "Partner domain (public HTTPS)"
msgstr "Dominio partner (HTTPS público)"

msgid "E.g. robotcar.example.com — not localhost. Must also be an Allowed Origin on developer.tesla.com"
msgstr "Ej. robotcar.example.com — no localhost. También debe ser un Allowed Origin en developer.tesla.com"

msgid "Developer credentials saved."
msgstr "Credenciales de desarrollador guardadas."

msgid "Keys generated: %(pub)s (to publish) and %(priv)s (secret, local)."
msgstr "Claves generadas: %(pub)s (a publicar) y %(priv)s (secreta, local)."

msgid "Set a partner domain first."
msgstr "Indica primero un dominio partner."

msgid "Partner register OK for « %(domain)s ». You can reconnect / resync vehicles now. Detail: %(result)s"
msgstr "Registro partner OK para « %(domain)s ». Ya puedes reconectar / resincronizar vehículos. Detalle: %(result)s"

msgid "No Tesla token — sign in first."
msgstr "No hay token Tesla: inicia sesión primero."

msgid "%(count)s vehicle(s) synchronized. Active: %(label)s."
msgstr "%(count)s vehículo(s) sincronizado(s). Activo: %(label)s."

msgid "No vehicles on the Tesla account."
msgstr "No hay vehículos en la cuenta Tesla."

msgid "Resync failed: %(err)s"
msgstr "Resincronización fallida: %(err)s"

msgid "Tesla account disconnected (tokens and vehicles removed)."
msgstr "Cuenta Tesla desconectada (tokens y vehículos eliminados)."

msgid "Active vehicle updated."
msgstr "Vehículo activo actualizado."

msgid "Unknown vehicle."
msgstr "Vehículo desconocido."

msgid "Configure the Client ID and Client Secret first."
msgstr "Configura primero el Client ID y el Client Secret."

msgid "Tesla denied authorization: %(error)s (%(desc)s)"
msgstr "Tesla denegó la autorización: %(error)s (%(desc)s)"

msgid "Invalid OAuth callback (missing code or state). Please try again."
msgstr "Callback OAuth no válido (falta code o state). Inténtalo de nuevo."

msgid "Invalid OAuth callback (unknown or expired state). Sign in to MaTesla again, then use “Sign in with Tesla”."
msgstr "Callback OAuth no válido (state desconocido o caducado). Vuelve a entrar en MaTesla y usa «Iniciar sesión con Tesla»."

msgid "OAuth user not found."
msgstr "Usuario OAuth no encontrado."

msgid "Connected to Tesla, but no vehicles found on the account."
msgstr "Conectado a Tesla, pero no se encontraron vehículos en la cuenta."

msgid "Tesla connected — %(count)s vehicle(s): %(names)s. Active: %(label)s."
msgstr "Tesla conectado — %(count)s vehículo(s): %(names)s. Activo: %(label)s."

msgid "Unexpected error: %(err)s"
msgstr "Error inesperado: %(err)s"

msgid "Active vehicle: %(label)s"
msgstr "Vehículo activo: %(label)s"

msgid "Cannot reach %(url)s: %(err)s"
msgstr "No se puede alcanzar %(url)s: %(err)s"

msgid "%(url)s → HTTP %(code)s"
msgstr "%(url)s → HTTP %(code)s"

msgid "%(url)s does not contain a valid public key PEM"
msgstr "%(url)s no contiene un PEM de clave pública válido"

msgid "%(url)s is reachable but does not match the local key (%(path)s). Re-upload the file."
msgstr "%(url)s es accesible pero no coincide con la clave local (%(path)s). Vuelve a subir el archivo."

msgid "Public key OK: %(url)s"
msgstr "Clave pública correcta: %(url)s"

msgid "Missing Client ID / Secret."
msgstr "Faltan Client ID / Secret."

msgid "Partner token failed (%(code)s): %(body)s"
msgstr "Token partner fallido (%(code)s): %(body)s"

msgid "Missing app settings."
msgstr "Faltan ajustes de la aplicación."

msgid "Tesla rejects localhost as a partner domain. Use a public HTTPS domain (e.g. robotcar.example.com)."
msgstr "Tesla rechaza localhost como dominio partner. Usa un dominio HTTPS público (ej. robotcar.example.com)."

msgid "Public key not reachable by Tesla before register: %(msg)s"
msgstr "Clave pública no accesible por Tesla antes del registro: %(msg)s"

msgid "Partner register failed (%(code)s): %(body)s"
msgstr "Registro partner fallido (%(code)s): %(body)s"


msgid "Version timeline"
msgstr "Línea de tiempo de versiones"





msgid "Current"
msgstr "Actual"

