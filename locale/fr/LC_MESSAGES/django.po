msgid "Show public key"
msgstr "Afficher la clé publique"

msgid "Tesla account authorization"
msgstr "Autorisation du compte Tesla"

msgid "Tesla will ask you to confirm access. MaTesla never receives your password."
msgstr "Tesla vous demandera de confirmer l’accès. MaTesla ne reçoit jamais votre mot de passe."

msgid "Redirect URI"
msgstr "Redirect URI"

msgid "Sign in with Tesla"
msgstr "Se connecter avec Tesla"

msgid "Save the Client ID and secret in step 1 first."
msgstr "Enregistrez d’abord le Client ID et le secret à l’étape 1."

msgid "Partner domain (public HTTPS)"
msgstr "Domaine partenaire (HTTPS public)"

msgid "E.g. robotcar.example.com — not localhost. Must also be an Allowed Origin on developer.tesla.com"
msgstr "Ex. robotcar.example.com — pas localhost. Doit aussi être en Allowed Origin sur developer.tesla.com"

msgid "Developer credentials saved."
msgstr "Identifiants développeur enregistrés."

msgid "Keys generated: %(pub)s (to publish) and %(priv)s (secret, local)."
msgstr "Clés générées : %(pub)s (à publier) et %(priv)s (secret, local)."

msgid "Set a partner domain first."
msgstr "Indiquez un domaine partenaire d’abord."

msgid "Partner register OK for « %(domain)s ». You can reconnect / resync vehicles now. Detail: %(result)s"
msgstr "Partner register OK pour « %(domain)s ». Vous pouvez reconnecter / resynchroniser les véhicules. Détail : %(result)s"

msgid "No Tesla token — sign in first."
msgstr "Pas de token Tesla — connectez-vous d’abord."

msgid "%(count)s vehicle(s) synchronized. Active: %(label)s."
msgstr "%(count)s véhicule(s) synchronisé(s). Actif : %(label)s."

msgid "No vehicles on the Tesla account."
msgstr "Aucun véhicule sur le compte Tesla."

msgid "Resync failed: %(err)s"
msgstr "Resynchronisation échouée : %(err)s"

msgid "Tesla account disconnected (tokens and vehicles removed)."
msgstr "Compte Tesla déconnecté (tokens et véhicules supprimés)."

msgid "Active vehicle updated."
msgstr "Véhicule actif mis à jour."

msgid "Unknown vehicle."
msgstr "Véhicule inconnu."

msgid "Configure the Client ID and Client Secret first."
msgstr "Configurez d’abord le Client ID et le Client Secret."

msgid "Tesla denied authorization: %(error)s (%(desc)s)"
msgstr "Tesla a refusé l’autorisation : %(error)s (%(desc)s)"

msgid "Invalid OAuth callback (missing code or state). Please try again."
msgstr "Callback OAuth invalide (code ou state manquant). Réessayez."

msgid "Invalid OAuth callback (unknown or expired state). Sign in to MaTesla again, then use “Sign in with Tesla”."
msgstr "Callback OAuth invalide (state inconnu ou expiré). Reconnectez-vous à MaTesla puis relancez « Se connecter avec Tesla »."

msgid "OAuth user not found."
msgstr "Utilisateur OAuth introuvable."

msgid "Connected to Tesla, but no vehicles found on the account."
msgstr "Connecté à Tesla, mais aucun véhicule trouvé sur le compte."

msgid "Tesla connected — %(count)s vehicle(s): %(names)s. Active: %(label)s."
msgstr "Tesla connecté — %(count)s véhicule(s) : %(names)s. Actif : %(label)s."

msgid "Unexpected error: %(err)s"
msgstr "Erreur inattendue : %(err)s"

msgid "Active vehicle: %(label)s"
msgstr "Véhicule actif : %(label)s"

msgid "Cannot reach %(url)s: %(err)s"
msgstr "Impossible d’atteindre %(url)s : %(err)s"

msgid "%(url)s → HTTP %(code)s"
msgstr "%(url)s → HTTP %(code)s"

msgid "%(url)s does not contain a valid public key PEM"
msgstr "%(url)s ne contient pas un PEM de clé publique valide"

msgid "%(url)s is reachable but does not match the local key (%(path)s). Re-upload the file."
msgstr "%(url)s est accessible mais le contenu ne correspond pas à la clé locale (%(path)s). Réuploadez le fichier."

msgid "Public key OK: %(url)s"
msgstr "Clé publique OK : %(url)s"

msgid "Missing Client ID / Secret."
msgstr "Client ID / Secret manquants."

msgid "Partner token failed (%(code)s): %(body)s"
msgstr "Partner token échoué (%(code)s) : %(body)s"

msgid "Missing app settings."
msgstr "Paramètres d’application manquants."

msgid "Tesla rejects localhost as a partner domain. Use a public HTTPS domain (e.g. robotcar.example.com)."
msgstr "Tesla refuse localhost comme domaine partenaire. Utilisez un domaine HTTPS public (ex. robotcar.example.com)."

msgid "Public key not reachable by Tesla before register: %(msg)s"
msgstr "Clé publique non accessible par Tesla avant register : %(msg)s"

msgid "Partner register failed (%(code)s): %(body)s"
msgstr "Register partner échoué (%(code)s) : %(body)s"

