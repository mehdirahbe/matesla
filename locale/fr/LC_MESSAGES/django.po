#: matesla/TeslaPartner.py:121
#, python-format
msgid "Partner public key must be served over HTTPS (got %(scheme)s)."
msgstr ""
"La clé publique partenaire doit être servie en HTTPS (schéma reçu : "
"%(scheme)s)."

#: matesla/TeslaPartner.py:126
msgid "Could not read a host from that URL."
msgstr "Impossible de lire un hôte dans cette URL."

#: matesla/TeslaPartner.py:136
#, python-format
msgid ""
"Tesla always fetches the public key at https://%(host)s%(path)s — not at an "
"arbitrary path. Host the PEM there (any HTTPS server is fine: nginx, S3, "
"Cloudflare, GitHub Pages, …)."
msgstr ""
"Tesla récupère toujours la clé publique à https://%(host)s%(path)s — pas à "
"un chemin arbitraire. Hébergez le PEM à cette adresse (tout serveur HTTPS "
"convient : nginx, S3, Cloudflare, GitHub Pages, …)."

#: matesla/TeslaPartner.py:152
msgid ""
"Tesla rejects localhost as a partner domain. Use a public HTTPS domain."
msgstr ""
"Tesla refuse localhost comme domaine partenaire. Utilisez un domaine HTTPS "
"public."

#: matesla/TeslaPartner.py:165
#, python-format
msgid "Cannot reach %(url)s: %(err)s"
msgstr "Impossible d’atteindre %(url)s : %(err)s"

#: matesla/TeslaPartner.py:167
#, python-format
msgid "%(url)s → HTTP %(code)s"
msgstr "%(url)s → HTTP %(code)s"

#: matesla/TeslaPartner.py:173
#, python-format
msgid "%(url)s does not contain a valid public key PEM"
msgstr "%(url)s ne contient pas un PEM de clé publique valide"

#: matesla/TeslaPartner.py:181
#, python-format
msgid ""
"%(url)s is reachable but does not match the local key (%(path)s). Re-upload "
"the file."
msgstr ""
"%(url)s est accessible mais le contenu ne correspond pas à la clé locale "
"(%(path)s). Réuploadez le fichier."

#: matesla/TeslaPartner.py:186
#, python-format
msgid "Public key OK: %(url)s"
msgstr "Clé publique OK : %(url)s"

#: matesla/TeslaPartner.py:192
msgid "Missing Client ID / Secret."
msgstr "Client ID / Secret manquants."

#: matesla/TeslaPartner.py:209
#, python-format
msgid "Partner token failed (%(code)s): %(body)s"
msgstr "Partner token échoué (%(code)s) : %(body)s"

#: matesla/TeslaPartner.py:223
msgid "Missing app settings."
msgstr "Paramètres d’application manquants."

#: matesla/TeslaPartner.py:229
msgid ""
"Tesla rejects localhost as a partner domain. Use a public HTTPS domain (e.g."
" robotcar.example.com)."
msgstr ""
"Tesla refuse localhost comme domaine partenaire. Utilisez un domaine HTTPS "
"public (ex. robotcar.example.com)."

#: matesla/TeslaPartner.py:237
#, python-format
msgid "Public key not reachable by Tesla before register: %(msg)s"
msgstr "Clé publique non accessible par Tesla avant register : %(msg)s"

#: matesla/TeslaPartner.py:255
#, python-format
msgid "Partner register failed (%(code)s): %(body)s"
msgstr "Register partner échoué (%(code)s) : %(body)s"

