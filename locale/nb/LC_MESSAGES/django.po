msgid "Change password"
msgstr "Endre passord"

#: templates/registration/password_reset_confirm.html:10
msgid "Secure account"
msgstr "Sikker konto"

#: templates/registration/password_reset_confirm.html:12
msgid "Choose a new password to get back into your space."
msgstr "Velg et nytt passord for å komme tilbake til området ditt."

#: templates/registration/password_reset_confirm.html:26
msgid "Expired link"
msgstr "Utløpt lenke"

#: templates/registration/password_reset_confirm.html:27
msgid "Invalid link"
msgstr "Ugyldig lenke"

#: templates/registration/password_reset_confirm.html:28
msgid ""
"The password reset link was invalid, possibly because it has already been "
"used. Please request a new password reset."
msgstr ""
"Lenken for tilbakestilling av passord var ugyldig, muligens fordi den "
"allerede er brukt. Be om en ny tilbakestilling."

#: templates/registration/password_reset_confirm.html:29
#: templates/registration/password_reset_form.html:4
#: templates/registration/password_reset_form.html:11
msgid "Password reset"
msgstr "Tilbakestill passord"

#: templates/registration/password_reset_done.html:4
#: templates/registration/password_reset_done.html:10
msgid "Password reset mail sent"
msgstr "E-post for tilbakestilling av passord sendt"

#: templates/registration/password_reset_done.html:9
msgid "Check your inbox"
msgstr "Sjekk innboksen din"

#: templates/registration/password_reset_done.html:11
msgid ""
"We&#39;ve emailed you instructions for setting your password, if an account "
"exists with the email you entered. You should receive them shortly."
msgstr ""
"Vi har sendt deg instruksjoner for å sette passordet, hvis det finnes en "
"konto med e-postadressen du oppga. Du bør motta dem snart."

#: templates/registration/password_reset_done.html:12
msgid ""
"If you don&#39;t receive an email, please make sure you&#39;ve entered the "
"address you registered with, and check your spam folder."
msgstr ""
"Hvis du ikke mottar e-post, sjekk at du har skrevet inn adressen du "
"registrerte deg med, og se i søppelpostmappen."

#: templates/registration/password_reset_done.html:13
#: templates/registration/password_reset_form.html:28
msgid "Back to login"
msgstr "Tilbake til innlogging"

#: templates/registration/password_reset_email.html:3
