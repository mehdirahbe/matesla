msgstr ""
"%(url)s er tilgjengelig, men samsvarer ikke med den lokale nøkkelen "
"(%(path)s). Last opp filen på nytt."

#: matesla/TeslaPartner.py:186
#, python-format
msgid "Public key OK: %(url)s"
msgstr "Offentlig nøkkel OK: %(url)s"

#: matesla/TeslaPartner.py:192
