msgstr "For å starte tilbakestilling av passord for din"

#: templates/registration/password_reset_email.html:3
msgid "MaTesla Account, click the link below:"
msgstr "MaTesla-konto, klikk på lenken nedenfor:"

#: templates/registration/password_reset_email.html:7
msgid ""
"If clicking the link above doesn't work, please copy and paste the URL in a "
"new browser window instead."
msgstr ""
"Hvis lenken ovenfor ikke fungerer, kopier og lim inn URL-en i et nytt "
"nettleservindu."

#: templates/registration/password_reset_email.html:9
msgid "Sincerely, The MaTesla Team"
msgstr "Vennlig hilsen, MaTesla-teamet"

#: templates/registration/password_reset_form.html:10
msgid "Account recovery"
msgstr "Kontogjenoppretting"

#: templates/registration/password_reset_form.html:12
msgid ""
"Enter the address linked to your account. We will send you a secure link."
msgstr ""
"Oppgi adressen knyttet til kontoen din. Vi sender deg en sikker lenke."

#: templates/registration/password_reset_form.html:25
msgid "Send e-mail"
msgstr "Send e-post"

