#, python-format
msgid "%(url)s does not contain a valid public key PEM"
msgstr "%(url)s enthält kein gültiges PEM für einen öffentlichen Schlüssel"

#: matesla/TeslaPartner.py:181
#, python-format
msgid "%(url)s is reachable but does not match the local key (%(path)s). Re-upload the file."
msgstr "%(url)s ist erreichbar, stimmt aber nicht mit dem lokalen Schlüssel (%(path)s) überein. Laden Sie die Datei erneut hoch."

#: matesla/TeslaPartner.py:186
#, python-format
msgid "Public key OK: %(url)s"
msgstr "Öffentlicher Schlüssel OK: %(url)s"

#: matesla/TeslaPartner.py:192
msgid "Missing Client ID / Secret."
msgstr "Client ID / Secret fehlen."

#: matesla/TeslaPartner.py:209
#, python-format
msgid "Partner token failed (%(code)s): %(body)s"
msgstr "Partner-Token fehlgeschlagen (%(code)s): %(body)s"

#: matesla/TeslaPartner.py:223
