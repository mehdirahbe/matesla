#: matesla/TeslaPartner.py:121
#, python-format
msgid "Partner public key must be served over HTTPS (got %(scheme)s)."
msgstr "Der öffentliche Partnerschlüssel muss über HTTPS bereitgestellt werden (erhalten: %(scheme)s)."

#: matesla/TeslaPartner.py:126
msgid "Could not read a host from that URL."
msgstr "Aus dieser URL konnte kein Host gelesen werden."

#: matesla/TeslaPartner.py:136
#, python-format
msgid "Tesla always fetches the public key at https://%(host)s%(path)s — not at an arbitrary path. Host the PEM there (any HTTPS server is fine: nginx, S3, Cloudflare, GitHub Pages, …)."
msgstr "Tesla holt den öffentlichen Schlüssel immer unter https://%(host)s%(path)s ab — nicht unter einem beliebigen Pfad. Stellen Sie die PEM dort bereit (jeder HTTPS-Server eignet sich: nginx, S3, Cloudflare, GitHub Pages, …)."

#: matesla/TeslaPartner.py:152
msgid "Tesla rejects localhost as a partner domain. Use a public HTTPS domain."
msgstr "Tesla lehnt localhost als Partnerdomäne ab. Verwenden Sie eine öffentliche HTTPS-Domäne."

#: matesla/TeslaPartner.py:165
#, python-format
